[gd_scene format=3 uid="uid://c2gsnlt3cs3km"]

[sub_resource type="GDScript" id="GDScript_ldsl7"]
script/source = "extends RigidBody3D

signal hookCollided(dotProduct)

@onready var player: Marker3D = $\"../Player/RopeConnect\"

@onready var hookingDotProduct: float = 0;

func _integrate_forces(state: PhysicsDirectBodyState3D) -> void:
	for i in state.get_contact_count():
		var normal := state.get_contact_local_normal(i)
		var collider := state.get_contact_collider_object(i)
		#print(\"Contact with \", collider.name, \" normal: \", normal)
		
		var dirToPlayer: Vector3 = (global_position - player.global_position).normalized();
		#print(\"dirToPlayer: \", dirToPlayer);
		
		var dotProduct: float = normal.dot(dirToPlayer);
		
		#print(dotProduct);
		
		hookCollided.emit(dotProduct);
		
"

